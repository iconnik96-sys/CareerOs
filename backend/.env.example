# ==========================================
# CareerOS Backend Environment Template
# ==========================================

PORT=8000
HOST=0.0.0.0
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Supabase JWT Secret (Found in Supabase Dashboard -> Project Settings -> API -> JWT Settings)
# CRITICAL SECURITY CONFIGURATION: Backend strictly requires this to verify HMAC-SHA256 signatures.
# All authenticated AI and admin requests will fail closed (401/403) if this is unset.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Restrict CORS to exact authorized origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,https://careeros.vercel.app,https://careeros.netlify.app

# Optional Admin Key for programmatic internal operations
ADMIN_API_KEY=your-admin-api-key-here
FOUNDER_EMAIL=nikhil@gmail.com

# Rate Limiter Reverse Proxy Trust (Set to true only if behind Cloudflare/Render/Vercel proxy)
TRUST_PROXY_HEADERS=false

# Razorpay Payment Gateway Configuration (Test mode for development)
RAZORPAY_KEY_ID=rzp_test_careerOS2026
RAZORPAY_KEY_SECRET=test_secret_careerOS_sec_2026
RAZORPAY_WEBHOOK_SECRET=test_webhook_sec_2026
